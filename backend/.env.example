# backend/.env.example
# ============================================================
# ContractIQ Backend — Environment Configuration Template
#
# Copy this file to .env and populate with real values.
# NEVER commit the real .env file to version control.
# The .gitignore in this repo excludes .env and .env.*
# ============================================================

# Neon PostgreSQL connection string.
# Format: postgresql+psycopg2://user:password@host/dbname?sslmode=require
# Obtain this from your Neon project dashboard under "Connection Details".
DATABASE_URL=

# FastAPI application settings (optional — defaults shown)
APP_ENV=development
APP_DEBUG=true

# Google Gemini API key (Phase 4A)
# Obtain this from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=
