# backend/.env.example
# ============================================================
# ContractIQ Backend — Environment Configuration Template
#
# Copy this file to .env and populate with real values.
# NEVER commit the real .env file to version control.
# The .gitignore in this repo excludes .env and .env.*
# ============================================================

# Neon PostgreSQL connection string.
# Format: postgresql+psycopg2://user:password@host/dbname?sslmode=require
# Obtain this from your Neon project dashboard under "Connection Details".
DATABASE_URL=

# FastAPI application settings (optional — defaults shown)
APP_ENV=development
APP_DEBUG=true

# Google Gemini API key (Phase 4A & Phase 6A)
# Obtain this from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=

# Structured LLM settings (Phase 6A — optional defaults shown)
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
LLM_TEMPERATURE=0.0

# Authentication & Security (Phase 13A — JWT configuration)
# Generate a strong 32+ character random string for production
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Production CORS origins (Phase 20C — comma-separated list of allowed frontend domains)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8443
